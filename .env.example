BOT_TOKEN=your_telegram_bot_token
TUMBLR_API_KEY=your_tumblr_api_key

# Netscape-format cookies file for TikTok (optional, for private content)
INSTAGRAM_COOKIES_FILE=/path/to/instagram_cookies.txt
TIKTOK_COOKIES_FILE=/path/to/tiktok_cookies.txt

# optional
DOWNLOAD_DIR=/tmp/pyvd
MAX_FILE_SIZE_MB=50
