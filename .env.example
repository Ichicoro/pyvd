BOT_TOKEN=your_telegram_bot_token
TUMBLR_API_KEY=your_tumblr_api_key

# optional: userid whitelist
ALLOWED_USER_IDS=123456789,987654321

# Netscape-format cookies file for TikTok (optional, for private content)
INSTAGRAM_COOKIES_FILE=/path/to/instagram_cookies.txt
TIKTOK_COOKIES_FILE=/path/to/tiktok_cookies.txt
PIXIV_COOKIES_FILE=/path/to/pixiv_cookies.txt
YOUTUBE_COOKIES_FILE=/path/to/youtube_cookies.txt

# optional
DOWNLOAD_DIR=/tmp/pyvd
MAX_FILE_SIZE_MB=50

# optional: enables the Signal bot (requires the signal-cli-rest-api sidecar, see README)
SIGNAL_SERVICE=signal-cli-rest-api:8080
SIGNAL_PHONE_NUMBER=+15551234567
# optional: phone number/UUID whitelist for the Signal bot (unset = anyone can DM it)
SIGNAL_ALLOWED_IDS=+15551234567,+15557654321
# optional: reuse an already-registered host signal-cli account instead of the
# sidecar's own volume — must be an absolute path (no ~)
SIGNAL_CLI_DATA_DIR=/home/youruser/.local/share/signal-cli
